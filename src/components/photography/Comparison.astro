<figure class="final-comparison">
  <div class="comparison-images">
    <div><img src="/photography/frame-0.webp" width="384" height="384" alt="Reference capture N000" loading="lazy" /><span>One capture · N000</span></div>
    <div><img src="/photography/merged.webp" width="384" height="384" alt="Registered robust merge of N000 through N003" loading="lazy" /><span>Four captures · robust merge</span></div>
  </div>
  <label class="comparison-control" hidden>Inspect the same detail <input type="range" min="1" max="4" step="0.5" value="1" aria-label="Magnify both comparison images equally" /><output>1×</output></label>
  <figcaption>Identical framing and rendering: +2 EV, the same tone curve and sRGB encoding. Magnifying changes both inspection views equally.</figcaption>
</figure>
<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.final-comparison').forEach(figure => {
      const control=figure.querySelector<HTMLElement>('.comparison-control')!
      const range=figure.querySelector<HTMLInputElement>('input')!
      control.hidden=false
      range.addEventListener('input',()=>{
        figure.style.setProperty('--comparison-zoom',range.value)
        figure.querySelector('output')!.textContent=`${range.value}×`
      })
    })
  })
</script>
