---
interface Props { close?: boolean }
const { close = false } = Astro.props
---
<figure class:list={['opening-photo', { 'closing-photo': close }]}>
  <div class="photo-window">
    <img src="/photography/photograph.webp" width="759" height="1012" alt="Sunlight through the branches of a large tree, with a mountain and shaded rocks beneath it. Rendered from capture N000." loading={close ? 'lazy' : 'eager'} fetchpriority={close ? 'auto' : 'high'} />
    {!close && <a class="crop-locator" href="#across-space" aria-label="Inspect the selected region on the mountain beneath the branches"><span>Look closer ↗</span></a>}
  </div>
  <figcaption>{close ? 'The same measurements. A more informed estimate.' : 'One real Google Pixel capture. The outlined patch is our window into the measurements.'}</figcaption>
</figure>
