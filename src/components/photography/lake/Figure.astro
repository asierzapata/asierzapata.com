---
// One figure, a few named states. The stage stays on screen while its steps scroll past;
// whichever step is at the reading line sets `data-state`. Presenter mode drives the same attribute.
import './lake.css'
interface Props { kind: string; label: string; steps: { title: string; text: string }[] }
const { kind, label, steps } = Astro.props
---
<figure class="cheat-fig" data-fig={kind} data-state="0" data-states={steps.length} aria-label={label}>
  <div class="fig-pin">
    <div class="fig-frame">
      <div class="fig-stage"><slot /></div>
      <div class="fig-foot">
        <span class="fig-foot-label" data-foot>{`1 / ${steps.length} · ${steps[0].title}`}</span>
        <slot name="controls" />
      </div>
    </div>
  </div>
  <ol class="fig-steps">
    {steps.map((step, i) => <li data-step={i} data-active={i === 0 ? 'true' : 'false'}><div><span class="step-n">{i + 1} / {steps.length}</span><strong>{step.title}</strong><p>{step.text}</p></div></li>)}
  </ol>
</figure>
<script>
  import { mountLake } from '../../../lib/photography/lake/stage'
  document.addEventListener('astro:page-load', mountLake)
</script>
