---
import Figure from './Figure.astro'
import data from '../../../lib/photography/lake/data.json'
const steps = [
  { title: 'One brightness for everything', text: `This is the whole photo with a single brightness. Keep it dark and the sunset looks great, but the rocks are black. Turn it up and the rocks show up, but the sky burns out to pure white.` },
]
---
<Figure kind="tradeoff" label="One brightness for the whole frame: the sunset or the rocks" steps={steps}>
  <div class="layer" data-show="0" data-on="true"><img data-ev-image src="/photography/lake/ev-0.webp" width="1008" height="756" alt="The whole frame with one brightness setting: either the sky is right and the rocks are black, or the rocks are visible and the sky is blank white." loading="lazy" /></div>
  <label slot="controls" class="fig-range" data-show="0" data-on="true">Brightness
    <input type="range" aria-valuetext="×1 brighter" min={data.stops[0]} max={data.stops.at(-1)} step="1" value={data.stops[0]} data-ev data-walk={data.stops.join(' ')} />
    <output>×1</output>
  </label>
</Figure>
