---
import {cameraMarkup} from '../../../lib/photography/preview/camera-geometry.js'
import {pixelMarkup} from '../../../lib/photography/preview/pixel-geometry.js'
import {beats} from '../../../lib/photography/preview/beats'
import Grid from './Grid.astro'
import data from '../../../lib/photography/article-data.json'
const displacement=data.transforms[2]
const fallbackFor=(view:string,index:number)=>view==='camera'?`/photography/preview/camera-${index===0?'assembled':'separated'}.svg`:view==='patch'?'/photography/preview/pixel-patch.svg':view==='grid'?`/photography/grid-${index===5?'red':index===6?'green':'blue'}.svg`:view==='unaligned'?'/photography/unaligned.webp':view==='merged'?'/photography/merged.webp':view==='alignment'?'/photography/aligned.webp':view==='frames'?'/photography/frame-1.webp':view==='crop'||view==='noise'?'/photography/frame-0.webp':null
import '../anatomy.css'
import './preview.css'
---
<div class="hf-article">
  <div class="hf-preview-note"><span class="hf-status-dot"></span> Visual draft <span class="hf-note-divider">/</span> Your prose belongs here</div>
  <div class="hf-intro">
    <div class="hf-kicker">A photograph, taken apart</div>
    <h2>How did this come<br class="hf-desktop-break" /> from a phone?</h2>
    <div class="hf-copy-space hf-intro-copy" aria-label="Opening prose reserved for Asier"><span>Your opening</span><i></i><i></i></div>
  </div>
  <figure class="hf-opening">
    <div class="hf-opening-window"><img src="/photography/photograph.webp" width="759" height="1012" alt="A large tree in sunlight with a mountain behind it, rendered from the existing Google Pixel RAW fixture." fetchpriority="high" /><a href="#the-phone" class="hf-open-camera">Inside the camera <span aria-hidden="true">↘</span></a></div>
    <figcaption><span>01 / The photograph</span><span>Google Pixel source fixture · replacement photograph pending</span></figcaption>
  </figure>
  <div class="hf-reading-map" aria-label="Article sections"><a href="#the-phone">01 <span>Inside the camera</span></a><a href="#closer">02 <span>Across space</span></a><a href="#little-light">03 <span>Across time</span></a></div>
  <photo-preview class="hf-story" data-hf-state="0" data-hf-view="camera">
    <div class="hf-visual-column">
      <figure class="hf-visual iso iso-plate" data-theme="light">
        <div class="hf-stage">
          <div class="hf-panel hf-camera-panel" data-hf-panel="camera" set:html={cameraMarkup}></div>
          <div class="hf-panel hf-size-panel" data-hf-panel="size" hidden>
            <div class="hf-size-pieces"><div class="hf-large-sensor"><span></span></div><div class="hf-nail"><span></span><div class="hf-small-sensor"></div></div></div>
            <div class="hf-size-labels"><span>Your camera</span><span>Phone sensor</span></div>
            <div class="hf-pending-measurement">Dimensions to be set from the selected camera models</div>
          </div>
          <div class="hf-panel hf-patch-panel" data-hf-panel="patch" hidden set:html={pixelMarkup}></div>
          <div class="hf-panel hf-grid-panel" data-hf-panel="grid" hidden><Grid /></div>
          <div class="hf-panel hf-crop-panel" data-hf-panel="crop" hidden>
            <div class="hf-source-context"><img src="/photography/photograph.webp" width="759" height="1012" loading="lazy" alt="Full-image locator for the reconstructed crop" /><span></span></div>
            <img class="hf-large-crop" src="/photography/frame-0.webp" width="384" height="384" loading="lazy" alt="Actual bilinear reconstruction of the prepared native region" />
            <div class="hf-detail-glass"><img src="/photography/detail.webp" width="32" height="32" loading="lazy" alt="32 by 32 native-site detail around the numerical target" /></div>
          </div>
          <div class="hf-panel hf-noise-panel" data-hf-panel="noise" hidden>
            <div class="hf-noise-crop"><img src="/photography/frame-0.webp" width="384" height="384" loading="lazy" alt="Magnified actual single-frame fixture detail; a stronger low-light source remains to be selected" /></div>
            <div class="hf-inspection-tag">4× inspection · same rendered capture</div>
          </div>
          <div class="hf-panel hf-frames-panel" data-hf-panel="frames" hidden>
            {[0,1,2,3].map(i=><div class="hf-frame-tile"><img src={`/photography/frame-${i}.webp`} width="384" height="384" loading="lazy" alt={`Real capture N00${i}, same exposure and framing`} /><span>N00{i}</span></div>)}
          </div>
          <div class="hf-panel hf-result-panel" data-hf-panel="unaligned" hidden>
            <img class="hf-large-crop" src="/photography/unaligned.webp" width="384" height="384" loading="lazy" alt="Actual unregistered average of the four source captures" />
            <div class="hf-detail-glass"><img class="hf-detail-zoom" src="/photography/unaligned.webp" width="384" height="384" loading="lazy" alt="The same fixed detail, magnified four times" /></div>
            <div class="hf-inspection-tag">Average before alignment</div>
          </div>
          <div class="hf-panel hf-alignment-panel" data-hf-panel="alignment" style={`--hf-align-x:${100*displacement.dy/data.crop.width}%;--hf-align-y:${-100*displacement.dx/data.crop.height}%`} hidden>
            <div class="hf-registration-images"><img src="/photography/frame-0.webp" width="384" height="384" alt="Reference capture N000" loading="lazy" /><img class="hf-moving-observation" src="/photography/frame-2.webp" width="384" height="384" alt="Capture N002 translated into registration using the measured displacement" loading="lazy" /></div>
            <div class="hf-registration-target"><span></span><span></span></div>
            <div class="hf-registration-readout"><span>N000 ↔ N002</span><span>Δx {displacement.dx.toFixed(3)} · Δy {displacement.dy.toFixed(3)} px</span></div>
          </div>
          <div class="hf-panel hf-merge-panel" data-hf-panel="merged" hidden>
            <div class="hf-merge-pair"><div><img src="/photography/frame-0.webp" width="384" height="384" alt="Single reference capture, identical rendering" loading="lazy" /><span>One observation</span></div><div><img src="/photography/merged.webp" width="384" height="384" alt="Actual registered robust merge, identical rendering" loading="lazy" /><span>Four observations</span></div></div>
            <span class="hf-merge-caption">Matched framing · matched rendering</span>
          </div>
          <div class="hf-panel hf-bracket-panel" data-hf-panel="bracket" hidden>
            <div class="hf-exposure-sequence">{['Short','Medium','Long'].map((name,i)=><div class="hf-exposure-placeholder"><svg viewBox="0 0 160 200" role="img" aria-label={`${name} exposure slot; no actual photograph yet`}><rect x="18" y="20" width="72" height="103" rx="1" /><path d="M54 21V122M19 70H89M11 153H149M25 154V184M136 154V184" /><path d="M109 152V99L126 89M117 86L129 80L143 98L124 106Z" /></svg><span>{name} exposure</span><small>Source to select</small></div>)}</div>
            <span class="hf-bracket-caption">A real exposure bracket belongs here</span>
          </div>
        </div>
        <figcaption class="hf-visual-caption"><span data-hf-caption>Schematic phone camera</span><span data-hf-source>Not an exact iPhone teardown</span></figcaption>
      </figure>
    </div>
    <div class="hf-passages">
      {beats.map((beat,i)=><section id={beat.id} class="hf-beat" data-hf-beat={i} data-hf-view-name={beat.view}>
        <span class="hf-kicker">{beat.part}</span>
        <h2>{beat.title}</h2>
        <div class="hf-copy-space" aria-label={`Article prose reserved for Asier: ${beat.prompt}`}><span>Your words</span><i></i><i></i><i></i></div>
        {'hold' in beat&&beat.hold&&<span class="hf-live-hold"><span></span> A pause for your camera</span>}
        <span class="hf-author-prompt">{beat.prompt}</span>
        <noscript>{fallbackFor(beat.view,i)&&<img class="hf-static-still" src={fallbackFor(beat.view,i)!} alt={`Static visual: ${beat.title}`} loading="lazy" />}</noscript>
      </section>)}
    </div>
  </photo-preview>
  <section class="hf-closing" id="more-evidence"><span class="hf-kicker">Across space. Across time.</span><h2>One photograph.<br />More evidence.</h2><div class="hf-copy-space" aria-label="Closing prose reserved for Asier"><span>Your closing</span><i></i><i></i></div></section>
  <figure class="hf-ending-photo"><img src="/photography/photograph.webp" width="759" height="1012" alt="Return to the same opening photograph" loading="lazy" /><figcaption>Neighbouring positions. Neighbouring moments.</figcaption></figure>
  <div class="hf-sources"><details><summary>About this visual draft and its source material</summary><p>Working titles and illustration states; article prose is reserved for Asier. The iPhone-inspired camera and sensor cutaway are schematic. Optical geometry and the size comparison are not verified specifications of a particular device. Photographic calculations use the existing Google Pixel Bayer RAW fixture, not a capture from the illustrated phone. A stronger source photograph and a genuine exposure bracket remain to be selected.</p><p>Photographic derivatives: HDR+ Burst Photography Dataset, Hasinoff et al. (2016), <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. <a href="/photography/NOTICE.md">Attribution and notices</a> · <a href="/photography/article-data.json">Actual sample values and transforms</a>. Four real captures; translation-only registration of the prepared 384 × 384 region. Identical +2 EV, tone curve and display encoding for comparisons. <a href="/posts/how-your-phone-cheats/">Earlier article draft</a>.</p></details></div>
</div>
<script>
  import {mountPreview} from '../../../lib/photography/preview/scroll'
  document.addEventListener('astro:page-load',mountPreview)
</script>
